{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panday-skill-lifecycle-v2.schema.json",
  "title": "Panday Lifecycle Record v2",
  "type": "object",
  "required": ["schema_version", "record_id", "operation", "subject", "parents", "source_snapshot", "input_fingerprint", "evidence", "compatibility", "review_status", "authority_reference", "created_at", "tool_version"],
  "properties": {
    "schema_version": {"const": "panday-skill-lifecycle/v2"},
    "record_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["discover", "create", "inspect", "evaluate", "fix", "install", "card", "augment", "synthesize", "optimize", "connect", "migrate"]},
    "subject": {"type": "object", "required": ["identity", "fingerprint"], "properties": {"identity": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}, "additionalProperties": true},
    "parents": {"type": "array", "items": {"type": "object", "required": ["record_id", "identity", "fingerprint"], "properties": {"record_id": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}, "additionalProperties": false}},
    "source_snapshot": {"$ref": "#/$defs/fingerprint"},
    "input_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "output_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["claim", "status", "method", "coverage", "limitations"], "properties": {"claim": {"type": "string", "minLength": 1}, "status": {"enum": ["verified", "failed", "observed", "held", "unassessed"]}, "method": {"type": "string", "minLength": 1}, "coverage": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}, "reference": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "compatibility": {"type": "object"},
    "review_status": {"enum": ["reviewed", "held", "not_reviewed", "rejected"]},
    "authority_reference": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string", "minLength": 1},
    "execution_result": {"type": ["object", "null"]}
  },
  "$defs": {"fingerprint": {"type": "object", "required": ["algorithm", "digest"], "properties": {"algorithm": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "habi-skill-lifecycle-v1.schema.json",
  "title": "Habi Skill Lifecycle Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "record_type", "created_at", "subject", "scope", "claims", "findings", "lineage", "handoff"],
  "properties": {
    "schema": {"const": "habi-skill-lifecycle/v1"},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["create", "inspect", "evaluate", "fix", "install", "card"]},
    "created_at": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source_path", "fingerprint"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "fingerprint": {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm", "digest", "file_count", "byte_count"],
          "properties": {
            "algorithm": {"const": "sha256-tree-v1"},
            "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "file_count": {"type": "integer", "minimum": 0},
            "byte_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "purpose", "authority"],
      "properties": {
        "project": {"type": "string"},
        "purpose": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "consumers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claims": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "status", "method", "evidence", "coverage", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "failed", "observed", "held", "unassessed"]},
          "method": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
          "coverage": {"type": "string"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "findings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "severity", "disposition", "claim_id", "summary", "evidence"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "disposition": {"enum": ["open", "resolved", "accepted", "not_applicable"]},
          "claim_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["predecessor_record_ids", "parent_digest"],
      "properties": {
        "predecessor_record_ids": {"type": "array", "items": {"type": "string"}},
        "parent_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["to", "status", "blockers", "next_action"],
      "properties": {
        "to": {"type": ["string", "null"], "enum": ["create", "inspect", "evaluate", "fix", "install", "card", null]},
        "status": {"enum": ["ready", "held", "not_requested"]},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"}
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "description"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
